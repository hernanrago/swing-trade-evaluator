@baseUrl = http://localhost:8000

### Health check
GET {{baseUrl}}/health

### Evaluar lista de pares
### ["ETH", "BTC", "BNB", "SOL", "AVAX", "LINK", "XRP", "ADA", "XAU", "ZEC"]
### ["BTC","ETH","BNB","SOL","HYPE","ZEC","XRP","DOGE","XAU","LAB","PEPE","XAG","BSB","TAO","SUI","EDEN","BILL","AIA","AVAX","LINK","ADA"]
POST {{baseUrl}}/evaluations
Content-Type: application/json

{
  "pairs": ["ZEC","XRP","DOGE","XAU","LAB"]
}

### Top 10 pares por volumen (default)
POST {{baseUrl}}/evaluations/top
Content-Type: application/json

{}

### Top N pares por volumen
POST {{baseUrl}}/evaluations/top
Content-Type: application/json

{
  "top": 5
}

### Posiciones abiertas cruzadas con evaluaciones
GET {{baseUrl}}/positions

### Evaluar pares en modo intraday
POST {{baseUrl}}/evaluations
Content-Type: application/json

{
  "pairs": ["BTC", "ETH"],
  "mode": "intraday"
}

### Top 5 en modo intraday
POST {{baseUrl}}/evaluations/top
Content-Type: application/json

{
  "top": 5,
  "mode": "intraday"
}
